{
  "info": {
    "name": "Restaurante · cadena completa del negocio",
    "description": "Recorre el ciclo entero: insumo -> receta -> platillo -> mesa -> comanda -> cocina -> entrega -> cobro -> cuadre de caja. Verifica el descuento automatico de inventario, el costo calculado desde la receta, la regla de la caja abierta, la propina, la redencion de puntos y las reglas por rol. Cada corrida crea sus propios datos, asi que se puede repetir sobre la misma base.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Datos unicos por corrida: la coleccion se puede repetir sobre la misma base.",
          "if (!pm.collectionVariables.get('run_seed')) {",
          "  const seed = Date.now() % 100000;",
          "  pm.collectionVariables.set('run_seed', seed);",
          "  pm.collectionVariables.set('table_number', 900 + (seed % 99));",
          "  pm.collectionVariables.set('customer_phone', String(50000000 + seed));",
          "  pm.collectionVariables.set('today', new Date().toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ],
